VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# URL base de la API backend (obligatoria en producción)
VITE_API_URL=https://tu-backend.up.railway.app/api

# Activar solo cuando el newsletter y sus proveedores estén validados.
# Sin definir, se muestra en desarrollo y se oculta en producción.
VITE_NEWSLETTER_ENABLED=false

# Opcional — error tracking
VITE_SENTRY_DSN=

# Opcional — analítica de producto (sin clave permanece desactivada)
VITE_POSTHOG_KEY=
VITE_ANALYTICS_DEBUG=0
